# Copy to .env and adjust as needed.
# Local foundation uses SQLite in API Development settings by default.
# For Docker Compose + PostgreSQL, set Database__UseSqlite=false.

# Web
NEXT_PUBLIC_API_URL=http://localhost:5080
API_ORIGIN=http://localhost:5080

# API / Compose
POSTGRES_USER=futebol
POSTGRES_PASSWORD=futebol
POSTGRES_DB=futebol_atemporal
ConnectionStrings__Default=Host=postgres;Port=5432;Database=futebol_atemporal;Username=futebol;Password=futebol
Database__UseSqlite=false
Cors__Origins__0=http://localhost:3000
Seed__AdminEmail=admin@futebolatemporal.local
Seed__AdminPassword=Admin123!
ASPNETCORE_ENVIRONMENT=Development
