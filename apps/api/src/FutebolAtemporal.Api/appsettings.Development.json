{
  "Database": {
    "UseSqlite": true
  },
  "ConnectionStrings": {
    "Default": "Data Source=futebol-atemporal.dev.db"
  },
  "Cors": {
    "Origins": [ "http://localhost:3000" ]
  },
  "MercadoPago": {
    "ApiBaseUrl": "https://api.mercadopago.com",
    "DefaultExpirationMinutes": 60
  },
  "Seed": {
